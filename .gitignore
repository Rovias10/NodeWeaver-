# =====================================================================
# .gitignore unificado de StudyWeaver (raíz).
# Cubre backend (PHP/Composer) y frontend (Vite/Node).
# =====================================================================

# --- Variables de entorno y secretos ---
.env
.env.local
.env.*.local
*.env

# --- Dependencias ---
vendor/
node_modules/
backend/vendor/
frontend/node_modules/

# --- Builds y artefactos ---
dist/
dist-ssr/
frontend/dist/
*.local

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editores e IDE ---
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Herramientas internas ---
.claude/
claude.md
