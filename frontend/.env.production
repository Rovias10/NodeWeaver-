# Variables que Vite inyecta en el build de producción.
# Solo URLs públicas — ningún secreto. Es seguro committear este archivo.
# Vite carga .env.production automáticamente cuando se ejecuta `npm run build`.

# Endpoint del backend en producción. El cliente añade `?route=...` por sí solo
# (ver frontend/src/api/client.js), así que aquí va la URL hasta index.php.
VITE_API_BASE=https://api.villanuevarodrigo.com/index.php
